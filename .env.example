# Snows of Yesteryear public configuration example
# Copy only the settings needed for the features you intentionally enable.

# Minimal / core (no variables are required for local stdio).
# Recommended: keep durable data outside the checkout.
OMBRE_BUCKETS_DIR=/path/to/snows-of-yesteryear-data
# OMBRE_TRANSPORT=stdio

# Optional provider-backed write analysis and long-form growth.
# OMBRE_API_KEY=replace-with-provider-key
# OMBRE_BASE_URL=https://provider.example.invalid/v1
# OMBRE_DEHYDRATION_MODEL=provider-model-name

# Optional semantic embedding and related-memory features.
# OMBRE_EMBEDDING_API_KEY=replace-with-embedding-key
# OMBRE_EMBEDDING_BASE_URL=https://embedding.example.invalid/v1
# OMBRE_EMBEDDING_MODEL=embedding-model-name

# Optional Remember-Me asset integration. Install requirements-remember-me.txt first.
# Disabled unless OMBRE_RM_RUNTIME_ENABLED is true.
# OMBRE_RM_RUNTIME_ENABLED=false
# OMBRE_RM_DATA_ROOT=/path/to/remember-me-data
# OMBRE_PUBLIC_BASE_URL=https://snows-of-yesteryear.example.invalid

# Optional HTTP MCP. Do not use this for the minimal stdio path.
# OMBRE_TRANSPORT=streamable-http
# OMBRE_PORT=8000
# OMBRE_AUTH_TOKEN=replace-with-a-long-random-token
# OMBRE_HTTP_ALLOWED_ORIGINS=https://app.example.invalid
# OMBRE_MCP_ALLOW_QUERY_TOKEN=false
# OMBRE_MCP_QUERY_TOKEN=replace-with-a-separate-query-token
# OMBRE_MCP_ALLOW_ANONYMOUS_HTTP=false

# Advanced operator-only GitHub Actions backup/export. Leave unset to disable
# this OIDC-protected action. Use the repository authorized by its workflow.
# OMBRE_BACKUP_REPOSITORY=example-owner/example-backup

# Optional Dashboard authentication.
# OMBRE_DASHBOARD_PASSWORD=replace-with-a-strong-password
# OMBRE_DASHBOARD_SETUP_TOKEN=replace-with-a-one-time-setup-token

# Advanced / optional behavior.
# OMBRE_CONFLICT_DETECTION_ENABLED=true
# OMBRE_BREATH_MIN_SCORE=0.0
# OMBRE_RELATED_THRESHOLD=0.75
# OMBRE_RESPONSE_SEAL=replace-with-a-deployment-local-seal
# OMBRE_HOOK_URL=https://hook.example.invalid/snows-of-yesteryear
# OMBRE_HOOK_TOKEN=replace-with-hook-token
# OMBRE_HOOK_SKIP=false
# OMBRE_DIAG_TOOLS=false
# OMBRE_DIGEST_SCHEDULER=false
# OMBRE_DIGEST_DRY_RUN=true
# OMBRE_DIGEST_API_KEY=replace-with-digest-provider-key
# OMBRE_DIGEST_BASE_URL=https://provider.example.invalid/v1
# OMBRE_DIGEST_MODEL=provider-model-name
# OMBRE_DIGEST_MIN_DAYS=30

# Raw Evidence is included internal/operator-only code. It remains disabled by
# default and is intentionally omitted from this end-user configuration example.
# Backup-v2 settings remain omitted pending a separate operator review.
